{
  "manifest_version": 3,
  "name": "MMT – Theo dõi và lọc web",
  "description": "Duyệt web tự do có lọc, cảnh báo 18+ và theo dõi hạn mức web.",
  "version": "1.1.1",
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "idle",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/child/*",
        "https://*/child/*"
      ],
      "js": [
        "connect.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "pulse.js"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "adult",
        "enabled": true,
        "path": "adult-rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
