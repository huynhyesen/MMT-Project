{
  "manifest_version": 3,
  "name": "MMT – Theo dõi và lọc web",
  "description": "Đếm thời gian của các trang web được phụ huynh cho phép và chặn tên miền 18+.",
  "version": "1.0.1",
  "permissions": ["alarms", "declarativeNetRequest", "idle", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "worker.js"},
  "content_scripts": [{
    "matches": ["http://*/child/*", "https://*/child/*"],
    "js": ["connect.js"],
    "run_at": "document_start"
  }],
  "declarative_net_request": {
    "rule_resources": [{"id": "adult", "enabled": true, "path": "adult-rules.json"}]
  }
}
